<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IdCard.Hanel</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);installer\**</DefaultItemExcludes>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectShowLib.Standard" Version="2.1.0" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="OpenCvSharp4" Version="4.8.0.20230708" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.8.0.20230708" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.8.0.20230708" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="2.5.1" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="2.7.0" />
    <PackageReference Include="ViewFaceCore" Version="0.3.8" />
    <PackageReference Include="ViewFaceCore.Extension.SkiaSharp" Version="0.3.7" />
    <PackageReference Include="ViewFaceCore.model.face_detector" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.model.face_landmarker_pts5" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.model.face_recognizer" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.model.fas_first" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.model.fas_second" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.runtime.win.vc" Version="6.0.0" />
    <PackageReference Include="ViewFaceCore.runtime.win.x64" Version="6.0.7" />
    <PackageReference Include="ViewFaceCore.runtime.win.x86" Version="6.0.7" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AForge.Video.DirectShow">
      <HintPath>lib_v1.2.10\AForge.Video.DirectShow.dll</HintPath>
    </Reference>
    <Reference Include="LibUsbDotNetF">
      <HintPath>lib_v1.2.10\LibUsbDotNetF.dll</HintPath>
    </Reference>
    <Reference Include="NextBiometrics.Biometrics">
      <HintPath>lib_v1.2.10\NextBiometrics.Biometrics.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Crypt">
      <HintPath>lib_v1.2.10\RAR.IdCard.Crypt.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Models">
      <HintPath>lib_v1.2.10\RAR.IdCard.Models.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Sdk.Entities">
      <HintPath>lib_v1.2.10\RAR.IdCard.Sdk.Entities.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Sdk.Models">
      <HintPath>lib_v1.2.10\RAR.IdCard.Sdk.Models.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Sdk.Reader">
      <HintPath>lib_v1.2.10\RAR.IdCard.Sdk.Reader.dll</HintPath>
    </Reference>
    <Reference Include="RAR.IdCard.Sdk.Utils.TKCrypto">
      <HintPath>lib_v1.2.10\RAR.IdCard.Sdk.Utils.TKCrypto.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="hidapi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libiconv-2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libiconv.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libusb-1.0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libzbar-0-x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libzbar-0-x86.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libzbar-0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="lib\hidapi.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="model\detect.caffemodel">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="model\detect.prototxt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="model\sr.caffemodel">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="model\sr.prototxt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NBBiometrics.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- VC++ runtime x64 đi kèm app (onnxruntime, paddle2onnx, mkldnn, libusb cần) để máy đích không phải cài vc_redist -->
    <None Update="vcruntime\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove=".env" />
    <None Include=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="reader.log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>